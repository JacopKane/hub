{
  "$schema": "../../../../schema/part.schema.json",
  "id": "critic",
  "family": "tiers",
  "kind": "agent",
  "default": "off",
  "runs_in": [
    "claude_code",
    "cursor"
  ],
  "does": "A read-only agent for reviews where a miss is expensive, such as security, data loss and a review that decides a merge.",
  "children": [
    {
      "id": "model",
      "kind": "option",
      "type": "choice",
      "values": [
        "haiku",
        "sonnet",
        "opus"
      ],
      "default": "opus",
      "does": "The model critic runs on. Cursor gets the mapped name."
    },
    {
      "id": "effort",
      "kind": "option",
      "type": "choice",
      "values": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "default": "xhigh",
      "does": "How hard critic thinks before it answers."
    },
    {
      "id": "instructions",
      "kind": "group",
      "does": "The sections of critic's instructions.",
      "children": [
        {
          "id": "security",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Looks for security holes first."
        },
        {
          "id": "data_loss",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Looks for steps that can lose data."
        },
        {
          "id": "proof",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Checks every claim, gives the proof for each finding and ranks them by harm."
        },
        {
          "id": "no_public_steps",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Sends back pushes, comments and messages as the exact text, and never runs them."
        },
        {
          "id": "report_short",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Keeps the report short, with absolute paths."
        },
        {
          "id": "no_agents",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Starts no other agents, and names the ones it would need."
        }
      ]
    }
  ]
}
