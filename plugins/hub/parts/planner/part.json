{
  "$schema": "../../../../schema/part.schema.json",
  "id": "planner",
  "family": "tiers",
  "kind": "agent",
  "default": "off",
  "runs_in": [
    "claude_code",
    "cursor"
  ],
  "does": "An agent for plans, task splits and specs that code will follow. It writes only the plan file.",
  "children": [
    {
      "id": "model",
      "kind": "option",
      "type": "choice",
      "values": [
        "haiku",
        "sonnet",
        "opus"
      ],
      "default": "opus",
      "does": "The model planner runs on. Cursor gets the mapped name."
    },
    {
      "id": "effort",
      "kind": "option",
      "type": "choice",
      "values": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "default": "max",
      "does": "How hard planner thinks before it answers."
    },
    {
      "id": "instructions",
      "kind": "group",
      "does": "The sections of planner's instructions.",
      "children": [
        {
          "id": "plan_file_only",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Writes only the plan file the brief names."
        },
        {
          "id": "read_first",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Reads every source that governs the work first, and names them."
        },
        {
          "id": "plan_shape",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Gives the plan in one fixed shape, with tests first, sizes and risks."
        },
        {
          "id": "no_public_steps",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Sends back pushes, comments and messages as the exact text, and never runs them."
        },
        {
          "id": "report_short",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Keeps the report short, with absolute paths."
        },
        {
          "id": "no_agents",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Starts no other agents, and names the ones it would need."
        }
      ]
    }
  ]
}
