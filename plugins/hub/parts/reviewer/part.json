{
  "$schema": "../../../../schema/part.schema.json",
  "id": "reviewer",
  "family": "tiers",
  "kind": "agent",
  "default": "off",
  "runs_in": [
    "claude_code",
    "cursor"
  ],
  "does": "A read-only agent for code review, readiness checks and review of text people read.",
  "children": [
    {
      "id": "model",
      "kind": "option",
      "type": "choice",
      "values": [
        "haiku",
        "sonnet",
        "opus"
      ],
      "default": "opus",
      "does": "The model reviewer runs on. Cursor gets the mapped name."
    },
    {
      "id": "effort",
      "kind": "option",
      "type": "choice",
      "values": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "default": "high",
      "does": "How hard reviewer thinks before it answers."
    },
    {
      "id": "instructions",
      "kind": "group",
      "does": "The sections of reviewer's instructions.",
      "children": [
        {
          "id": "read_only",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Changes no file, and runs only commands that read."
        },
        {
          "id": "proof",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Checks every claim and gives the proof for each finding."
        },
        {
          "id": "rank_by_harm",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Ranks the findings by harm, the worst first."
        },
        {
          "id": "no_public_steps",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Sends back pushes, comments and messages as the exact text, and never runs them."
        },
        {
          "id": "report_short",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Keeps the report short, with absolute paths."
        },
        {
          "id": "no_agents",
          "kind": "instruction",
          "default": "on",
          "cost": "per use",
          "does": "Starts no other agents, and names the ones it would need."
        }
      ]
    }
  ]
}
