{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Delete|Edit|Shell|Write",
        "command": "python3 -I ./plugins/hub/lib/hub/adapters/cursor_hooks.py preToolUse",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "matcher": "Edit|Read|Write",
        "command": "python3 -I ./plugins/hub/lib/hub/adapters/cursor_hooks.py postToolUse"
      }
    ],
    "sessionStart": [
      {
        "matcher": "",
        "command": "python3 -I ./plugins/hub/lib/hub/adapters/cursor_hooks.py sessionStart"
      }
    ],
    "stop": [
      {
        "matcher": "",
        "command": "python3 -I ./plugins/hub/lib/hub/adapters/cursor_hooks.py stop"
      }
    ],
    "subagentStop": [
      {
        "matcher": "",
        "command": "python3 -I ./plugins/hub/lib/hub/adapters/cursor_hooks.py subagentStop"
      }
    ]
  }
}
