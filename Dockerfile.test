# The Linux test image. Run from the repo root:
#   docker build -f Dockerfile.test -t hub-test .
#   docker run --rm -v "$PWD:/src" -w /src hub-test python3 -m pytest -q
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git tmux \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pytest==9.2.0

# A normal user, so the tests never run as root and write nothing root-owned into the mounted repo.
RUN useradd --create-home --uid 1000 tester
USER tester
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTEST_ADDOPTS="-p no:cacheprovider"
WORKDIR /src
